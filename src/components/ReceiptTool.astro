---
import {
  CATEGORY_SUGGESTIONS,
  EVIDENCE_STATES,
  EVIDENCE_TYPES,
  PAY_METHODS,
  PERIOD_STATES,
  SUBMIT_STATES
} from '../lib/receipts';

const today = new Date().toISOString().slice(0, 10);
---

<div id="receipt-tool" data-tool>
  <p class="notice info no-print">
    <strong>서버에 올라가지 않는 도구입니다</strong>
    입력한 내용은 이 브라우저의 저장소에만 들어갑니다. 계정을 만들거나 영수증 파일을 전송하지 않아도 됩니다.
    다만 브라우저 데이터를 비우면 사라지므로, 마감 뒤에는 아래 CSV·JSON 내보내기로 백업하세요.
    여기서 고르는 항목은 정리용 분류일 뿐이며, 실제 인정 여부·서식 기준은 담당 주관기관 안내를 확인해야 합니다.
  </p>

  <div class="card no-print" style="margin-bottom:1.2rem">
    <h2 style="margin-top:0;font-size:1.05rem;border:0;padding:0">새 지출 추가</h2>
    <p class="notice" data-load-note hidden style="margin-top:0"></p>
    <div class="row" role="group" aria-label="지출 입력">
      <div>
        <label for="f-date">지출일</label>
        <input type="date" id="f-date" value={today} required />
      </div>
      <div>
        <label for="f-vendor">거래처</label>
        <input type="text" id="f-vendor" placeholder="예: 원단상사" autocomplete="off" />
      </div>
      <div>
        <label for="f-amount">금액 (원)</label>
        <input type="number" id="f-amount" min="1" step="1" placeholder="예: 150000" inputmode="numeric" />
      </div>
      <div>
        <label for="f-budget">비목(예산과목)</label>
        <input type="text" id="f-budget" list="budget-list" placeholder="예: 시제품 제작" autocomplete="off" />
        <datalist id="budget-list">
          {CATEGORY_SUGGESTIONS.map((c) => <option value={c} />)}
        </datalist>
      </div>
      <div>
        <label for="f-pay">결제경로</label>
        <select id="f-pay">{PAY_METHODS.map((m) => <option value={m}>{m}</option>)}</select>
      </div>
      <div>
        <label for="f-period">집행 기간</label>
        <select id="f-period">{PERIOD_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div>
        <label for="f-evidence">증빙 종류</label>
        <select id="f-evidence">
          {EVIDENCE_TYPES.map((t) => <option value={t} selected={t === '없음'}>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="f-estate">수취 상태</label>
        <select id="f-estate">{EVIDENCE_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div>
        <label for="f-submit">제출 상태</label>
        <select id="f-submit">{SUBMIT_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div style="flex:2 1 220px">
        <label for="f-memo">메모</label>
        <input type="text" id="f-memo" placeholder="용도·요청받은 사람 한 줄" autocomplete="off" />
      </div>
      <div class="shrink">
        <button class="btn" type="button" data-add>추가</button>
      </div>
    </div>
    <p class="small muted" data-form-msg style="margin:.6rem 0 0"></p>
  </div>

  <div class="card" style="margin-bottom:1.2rem">
    <h2 style="margin-top:0;font-size:1.05rem;border:0;padding:0">정리 현황</h2>
    <div class="row no-print" role="group" aria-label="필터" style="margin-bottom:1rem">
      <div>
        <label for="q-from">시작일</label>
        <input type="date" id="q-from" />
      </div>
      <div>
        <label for="q-to">종료일</label>
        <input type="date" id="q-to" />
      </div>
      <div>
        <label for="q-budget">비목</label>
        <select id="q-budget">
          <option value="">전체</option>
          {CATEGORY_SUGGESTIONS.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div>
        <label for="q-pay">결제경로</label>
        <select id="q-pay">
          <option value="">전체</option>
          {PAY_METHODS.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>
      <div>
        <label for="q-period">집행 기간</label>
        <select id="q-period">
          <option value="">전체</option>
          {PERIOD_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div>
        <label for="q-evidence">증빙 종류</label>
        <select id="q-evidence">
          <option value="">전체</option>
          {EVIDENCE_TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="q-estate">수취 상태</label>
        <select id="q-estate">
          <option value="">전체</option>
          {EVIDENCE_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div>
        <label for="q-submit">제출 상태</label>
        <select id="q-submit">
          <option value="">전체</option>
          {SUBMIT_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div style="flex:2 1 200px">
        <label for="q-text">거래처·비목·메모 검색</label>
        <input type="search" id="q-text" placeholder="예: 택배" />
      </div>
      <div class="shrink">
        <button class="btn ghost" type="button" data-reset-filters>필터 해제</button>
      </div>
    </div>

    <dl data-summary style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin:0 0 1rem">
      <div><dt class="small muted">총 집행액</dt><dd data-sum-total style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
      <div><dt class="small muted">입력 건수</dt><dd data-sum-count style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
      <div><dt class="small muted">전용카드로 결제</dt><dd data-sum-dedicated style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
      <div><dt class="small muted">수취구멍(미수취·재요청)</dt><dd data-sum-gap style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
      <div><dt class="small muted">기간 리스크(기간 외·확인 필요)</dt><dd data-sum-period style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
      <div><dt class="small muted">제출 전</dt><dd data-sum-unsent style="margin:0;font-size:1.3rem;font-weight:800">-</dd></div>
    </dl>

    <div class="table-scroll">
      <table>
        <caption class="small muted" style="text-align:left;caption-side:top">비목(예산과목)별 합계</caption>
        <thead><tr><th scope="col">비목</th><th scope="col">건수</th><th scope="col">금액</th></tr></thead>
        <tbody data-by-budget><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
      </table>
    </div>

    <div class="table-scroll">
      <table>
        <caption class="small muted" style="text-align:left;caption-side:top">증빙 종류별 합계</caption>
        <thead><tr><th scope="col">증빙 종류</th><th scope="col">건수</th><th scope="col">금액</th></tr></thead>
        <tbody data-by-evidence><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
      </table>
    </div>

    <div class="table-scroll">
      <table>
        <caption class="small muted" style="text-align:left;caption-side:top">월별 집행액</caption>
        <thead><tr><th scope="col">월</th><th scope="col">건수</th><th scope="col">금액</th></tr></thead>
        <tbody data-by-month><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="card no-print" style="margin-bottom:1.2rem" data-gap-card hidden>
    <h2 style="margin-top:0;font-size:1.05rem;border:0;padding:0">재요청이 필요한 건 <span class="muted small">(수취 못 한 순서대로)</span></h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">지출일</th><th scope="col">거래처</th><th scope="col">금액</th>
            <th scope="col">비목</th><th scope="col">수취 상태</th><th scope="col">메모</th>
          </tr>
        </thead>
        <tbody data-gap-rows></tbody>
      </table>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.2rem">
    <h2 style="margin-top:0;font-size:1.05rem;border:0;padding:0">입력 목록 <span class="muted small">(필터 적용된 결과)</span></h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">지출일</th><th scope="col">거래처</th><th scope="col">금액</th>
            <th scope="col">비목</th><th scope="col">결제경로</th><th scope="col">집행 기간</th>
            <th scope="col">증빙 종류</th><th scope="col">수취</th><th scope="col">제출</th>
            <th scope="col">메모</th><th scope="col" class="no-print"><span aria-hidden="true">지우기</span></th>
          </tr>
        </thead>
        <tbody data-rows><tr><td colspan="11" class="muted">아직 입력이 없습니다.</td></tr></tbody>
        <tfoot data-foot hidden>
          <tr><th scope="row">합계</th><td></td><td data-foot-amount></td><td colspan="8"></td></tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="row no-print" style="align-items:start">
    <div class="shrink"><button class="btn" type="button" data-export-csv>CSV 내보내기</button></div>
    <div class="shrink"><button class="btn ghost" type="button" data-export-json>JSON 백업</button></div>
    <div>
      <label for="import-file">JSON 복원</label>
      <input type="file" id="import-file" accept="application/json,.json" />
    </div>
    <div class="shrink"><button class="btn ghost" type="button" data-clear>지출 목록 비우기</button></div>
  </div>
  <p class="small muted no-print" style="margin-top:.4rem">
    <strong>지출 목록 비우기</strong>는 이 브라우저에 저장된 지출 항목만 삭제합니다. 체크리스트 확인 결과는 그대로 남습니다.
  </p>

  <p class="notice" data-storage-warning hidden>
    <strong>브라우저 저장에 실패했습니다</strong>
    시크릿 창이거나 저장 한도를 넘어선 것으로 보입니다. 지금 입력은 새로고침 뒤 사라집니다. JSON 백업을 먼저 받으세요.
  </p>
  <p class="small muted" data-status role="status" aria-live="polite"></p>
</div>

<script>
  import {
    computeTotals,
    csvFileName,
    evidenceGapList,
    exportPeriod,
    filterEntries,
    formatKRW,
    makeId,
    normalizeEntry,
    toCsvFile,
    type Filters,
    type ReceiptEntry
  } from '../lib/receipts';
  import {
    backupFileName,
    clearEntries,
    loadStateDetailed,
    parseBackup,
    replaceEntries,
    saveEntries,
    saveMeta,
    serializeState,
    STORAGE_KEY
  } from '../lib/storage';

  const root = document.querySelector<HTMLElement>('[data-tool]');

  if (root) {
    const el = (name: string): HTMLElement | null => root.querySelector<HTMLElement>(`[data-${name}]`);
    const input = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const val = (id: string) => input<HTMLInputElement | HTMLSelectElement>(id)?.value ?? '';
    const rowsBody = el('rows');
    const gapBody = el('gap-rows');
    const gapCard = el('gap-card');
    const foot = el('foot');
    const footAmount = el('foot-amount');
    const status = el('status');
    const formMsg = el('form-msg');
    const warning = el('storage-warning');
    const loadNote = el('load-note');

    const FILTER_IDS = ['q-from', 'q-to', 'q-budget', 'q-pay', 'q-period', 'q-evidence', 'q-estate', 'q-submit', 'q-text'];
    const SUGGESTED = new Set(
      Array.from(document.querySelectorAll('#budget-list option')).map((o) => (o as HTMLOptionElement).value)
    );

    const loaded = loadStateDetailed();
    let state = loaded.state;
    let filters: Filters = {};
    /** 지운 id 기록(저장소에 함께 둔다). 오래된 화면을 든 다른 탭이 같은 id 를 보내도 되살아나지 않습니다. */
    let removedIds: string[] = loaded.state.removed.slice();
    let droppedCount = loaded.dropped;
    let writeBlocked = loaded.future;

    function showLoadNote() {
      if (!loadNote) return;
      const notes: string[] = [];
      if (writeBlocked) {
        notes.push(
          '이 브라우저에 이 사이트의 더 새로운 형식 데이터가 있습니다. 형식을 되돌리면 데이터를 잃으므로 저장을 멈추고 읽기만 합니다. JSON 백업을 받은 뒤 그 버전을 쓰는 화면에서 열어 주세요.'
        );
      }
      if (droppedCount > 0) {
        notes.push(`저장된 항목 중 형식 때문에 읽지 못한 ${droppedCount}건이 있습니다. 그 행은 화면에 없는 것과 같고, 새로 저장하면 저장소에서 사라집니다.`);
      }
      loadNote.textContent = notes.join(' ');
      loadNote.hidden = notes.length === 0;
    }
    showLoadNote();

    function field(id: string): string {
      return val(id).trim();
    }

    function download(name: string, text: string, type: string) {
      const blob = new Blob([text], { type });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function cell(text: string, bold = false): HTMLElement {
      const td = document.createElement('td');
      td.textContent = text;
      if (bold) td.style.fontWeight = '700';
      return td;
    }

    function emptyRow(colSpan: number, text: string): HTMLElement {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = colSpan;
      td.className = 'muted';
      td.textContent = text;
      tr.appendChild(td);
      return tr;
    }

    /**
     * 비목 필터는 예시 목록에 없던 실제 입력값도 드롭다운에 쌓이도록 갱신합니다.
     * 반환값은 갱신 뒤 드롭다운에 실제로 선택된 값 — 지금 선택된 항목은 어떤 경우에도
     * 목록에서 지우지 않습니다(지우면 화면은 '전체' 를 보이는데 필터는 걸린 채로 집계되는 사고가 납니다).
     */
    function syncBudgetOptions(items: ReceiptEntry[], keep: string): string {
      const select = input<HTMLSelectElement>('q-budget');
      if (!select) return keep;
      const needed = new Set(items.map((e) => e.budgetItem).filter((b) => !SUGGESTED.has(b)));
      // removeOption() 은 WebKit 전용이라 표준 API 인 remove(index) 로 지웁니다(뒤에서부터).
      for (let i = select.options.length - 1; i >= 0; i--) {
        const opt = select.options[i];
        const v = opt.value;
        if (v && v !== keep && !SUGGESTED.has(v) && !needed.has(v)) select.remove(i);
      }
      const present = new Set(Array.from(select.options).map((o) => o.value));
      for (const key of [...needed].sort((a, b) => a.localeCompare(b, 'ko'))) {
        if (present.has(key)) continue;
        const opt = document.createElement('option');
        opt.value = key;
        opt.textContent = key;
        select.appendChild(opt);
      }
      select.value = keep;
      // keep 이 목록에 없던 값이라 브라우저가 선택을 유지 못 한 경우: 실제 표시된 값에 맞춰 필터를 고칩니다.
      return select.value;
    }

    function render() {
      const list = filterEntries(state.entries, filters);
      const totals = computeTotals(list);
      const gaps = evidenceGapList(list);

      const sum = (name: string, text: string) => {
        const node = el(name);
        if (node) node.textContent = text;
      };
      sum('sum-total', formatKRW(totals.total));
      sum('sum-count', `${totals.count}건`);
      sum('sum-dedicated', `${formatKRW(totals.dedicatedTotal)} (${totals.dedicatedRate}%)`);
      sum('sum-gap', `${totals.evidenceGapCount}건 · ${formatKRW(totals.evidenceGapTotal)}`);
      sum('sum-period', `${totals.periodRiskCount}건 · ${formatKRW(totals.periodRiskTotal)}`);
      sum('sum-unsent', `${totals.notSubmittedCount}건 · ${formatKRW(totals.notSubmittedTotal)}`);

      const fillGroup = (name: string, groups: { key: string; count: number; total: number }[]) => {
        const tbody = el(name);
        if (!tbody) return;
        tbody.textContent = '';
        if (groups.length === 0) {
          tbody.appendChild(emptyRow(3, '자료가 없습니다'));
          return;
        }
        for (const g of groups) {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = g.key;
          tr.appendChild(th);
          tr.appendChild(cell(`${g.count}건`));
          tr.appendChild(cell(formatKRW(g.total), true));
          tbody.appendChild(tr);
        }
      };
      fillGroup('by-budget', totals.byBudgetItem);
      fillGroup('by-evidence', totals.byEvidenceType);
      fillGroup('by-month', totals.byMonth);

      if (gapCard && gapBody) {
        gapCard.hidden = gaps.length === 0;
        gapBody.textContent = '';
        for (const e of gaps.slice(0, 30)) {
          const tr = document.createElement('tr');
          tr.appendChild(cell(e.date));
          tr.appendChild(cell(e.vendor || '-'));
          tr.appendChild(cell(formatKRW(e.amount), true));
          tr.appendChild(cell(e.budgetItem));
          tr.appendChild(cell(e.evidenceState));
          tr.appendChild(cell(e.memo || '-'));
          gapBody.appendChild(tr);
        }
      }

      if (rowsBody) {
        rowsBody.textContent = '';
        if (list.length === 0) {
          rowsBody.appendChild(emptyRow(11, '조건에 맞는 입력이 없습니다.'));
        }
        for (const e of list) {
          const tr = document.createElement('tr');
          tr.appendChild(cell(e.date));
          tr.appendChild(cell(e.vendor || '-'));
          tr.appendChild(cell(formatKRW(e.amount)));
          tr.appendChild(cell(e.budgetItem));
          tr.appendChild(cell(e.payMethod));
          tr.appendChild(cell(e.periodState));
          tr.appendChild(cell(e.evidenceType));
          tr.appendChild(cell(e.evidenceState));
          tr.appendChild(cell(e.submitState));
          tr.appendChild(cell(e.memo || '-'));
          const td = document.createElement('td');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn ghost small no-print';
          btn.textContent = '지우기';
          btn.dataset.id = e.id;
          btn.addEventListener('click', () => remove(e.id));
          td.appendChild(btn);
          tr.appendChild(td);
          rowsBody.appendChild(tr);
        }
      }
      if (foot && footAmount) {
        foot.hidden = list.length === 0;
        footAmount.textContent = formatKRW(totals.total);
      }
      const shownBudget = syncBudgetOptions(state.entries, val('q-budget'));
      if (shownBudget !== (filters.budgetItem ?? '')) {
        filters = { ...filters, budgetItem: shownBudget || undefined };
      }
      if (status) {
        const saved = writeBlocked ? ' · 더 새로운 형식 데이터라 저장은 멈춰 있음' : '';
        status.textContent = `전체 ${state.entries.length}건 중 ${list.length}건 표시 · 데이터는 이 브라우저에만 저장됩니다${saved}`;
      }
    }

    /** 저장. 실패·차단은 화면에 알리고, 다른 탭이 추가한 행은 합쳐서 가져옵니다. */
    function persist() {
      if (writeBlocked) {
        if (warning) warning.hidden = false;
        showLoadNote();
        return;
      }
      const res = saveEntries(state.entries, removedIds);
      if (res.future) {
        writeBlocked = true;
        showLoadNote();
        if (warning) warning.hidden = false;
        render();
        return;
      }
      if (res.ok) {
        state.entries = res.merged;
        removedIds = res.removed;
      }
      if (warning) warning.hidden = res.ok;
    }

    function remove(id: string) {
      const before = state.entries.length;
      state.entries = state.entries.filter((e) => e.id !== id);
      if (state.entries.length !== before) {
        removedIds.push(id);
        persist();
        render();
      }
    }

    function add() {
      const rawAmount = field('f-amount');
      const amount = Number(rawAmount);
      if (rawAmount === '' || !Number.isFinite(amount) || amount <= 0) {
        if (formMsg) formMsg.textContent = '금액을 1 원 이상의 숫자로 입력하세요. 0 원·빈값은 저장하지 않습니다.';
        input<HTMLInputElement>('f-amount')?.focus();
        return;
      }
      const entry = normalizeEntry({
        id: makeId(),
        date: field('f-date'),
        vendor: field('f-vendor'),
        amount,
        budgetItem: field('f-budget'),
        payMethod: val('f-pay'),
        periodState: val('f-period'),
        evidenceType: val('f-evidence'),
        evidenceState: val('f-estate'),
        submitState: val('f-submit'),
        memo: field('f-memo')
      });
      if (!entry) {
        if (formMsg) formMsg.textContent = '지출일 형식(YYYY-MM-DD)을 확인해 주세요.';
        return;
      }
      state.entries.push(entry);
      state.entries.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
      persist();
      render();
      if (formMsg) {
        formMsg.textContent = `${entry.date} · ${entry.vendor || '이름 없음'} ${formatKRW(entry.amount)} · ${entry.budgetItem} 추가됨`;
      }
      const vendor = input<HTMLInputElement>('f-vendor');
      const amountInput = input<HTMLInputElement>('f-amount');
      const memo = input<HTMLInputElement>('f-memo');
      if (vendor) vendor.value = '';
      if (amountInput) amountInput.value = '';
      if (memo) memo.value = '';
      vendor?.focus();
    }

    el('add')?.addEventListener('click', add);

    const syncFilters = () => {
      filters = {
        from: field('q-from') || undefined,
        to: field('q-to') || undefined,
        budgetItem: val('q-budget') || undefined,
        payMethod: val('q-pay') || undefined,
        periodState: val('q-period') || undefined,
        evidenceType: val('q-evidence') || undefined,
        evidenceState: val('q-estate') || undefined,
        submitState: val('q-submit') || undefined,
        q: field('q-text') || undefined
      };
      render();
    };
    for (const id of FILTER_IDS) {
      const node = document.getElementById(id);
      node?.addEventListener('change', syncFilters);
      if (node instanceof HTMLInputElement && node.type === 'search') node.addEventListener('input', syncFilters);
    }
    el('reset-filters')?.addEventListener('click', () => {
      resetFilterControls();
      render();
      if (status) status.textContent = '필터를 해제했습니다.';
    });

    el('export-csv')?.addEventListener('click', () => {
      // 화면에 보이는(필터 적용) 결과만 내보냅니다. 조건에 안 맞는 행을 몰래 포함시키지 않습니다.
      const visible = filterEntries(state.entries, filters);
      if (visible.length === 0) {
        if (status) {
          status.textContent =
            state.entries.length > 0
              ? '필터 조건에 맞는 건이 없어 내보낼 수 없습니다. 필터를 해제하거나 기간을 넓혀 주세요.'
              : '내보낼 데이터가 없습니다.';
        }
        return;
      }
      const name = csvFileName(exportPeriod(filters));
      download(name, toCsvFile(visible), 'text/csv;charset=utf-8');
      state.lastExportAt = new Date().toISOString();
      saveMeta({ lastExportAt: state.lastExportAt });
      if (status) status.textContent = `${name} · ${visible.length}건 내보냄 (화면에 표시된 결과만)`;
    });

    el('export-json')?.addEventListener('click', () => {
      download(backupFileName(), serializeState(state), 'application/json;charset=utf-8');
    });

    /** 필터 DOM 과 상태(filters)를 한 번에 초기화 — 두어가 어긋나는 창을 없앱니다. */
    function resetFilterControls() {
      for (const id of FILTER_IDS) {
        const node = input<HTMLInputElement | HTMLSelectElement>(id);
        if (node) node.value = '';
      }
      filters = {};
    }

    const fileInput = input<HTMLInputElement>('import-file');
    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const text = String(reader.result ?? '');
        const { state: restored, dropped, future } = parseBackup(text);
        if (future) {
          if (status) status.textContent = '이 파일은 이 사이트의 더 새로운 형식 데이터입니다. 복원하지 않았습니다.';
          fileInput.value = '';
          return;
        }
        if (restored.entries.length === 0 && !confirm('이 파일에서 읽을 수 있는 지출 항목이 없습니다. 현재 데이터를 그대로 둘까요?')) {
          fileInput.value = '';
          return;
        }
        if (!confirm(`${restored.entries.length}건을 복원합니다. 현재 목록(${state.entries.length}건)은 대체됩니다.`)) {
          fileInput.value = '';
          return;
        }
        state.entries = restored.entries;
        removedIds = [];
        droppedCount = dropped;
        resetFilterControls();
        // 복원은 목록 전체를 대체합니다(다른 탭 행과 병합하지 않음). 체크리스트는 저장된 값 그대로 둡니다.
        const res = replaceEntries(state.entries);
        writeBlocked = res.future;
        if (warning) warning.hidden = res.ok;
        showLoadNote();
        render();
        const skipped = dropped > 0 ? ` · 형식 오류 ${dropped}건은 건너뜀` : '';
        if (status) status.textContent = `복원 완료 · ${state.entries.length}건${skipped}`;
        fileInput.value = '';
      };
      reader.onerror = () => {
        if (status) status.textContent = '파일을 읽을 수 없습니다.';
        fileInput.value = '';
      };
      reader.readAsText(file, 'utf-8');
    });

    el('clear')?.addEventListener('click', () => {
      if (state.entries.length === 0) {
        if (status) status.textContent = '지출 목록에 남은 항목이 없습니다. (체크리스트는 비우지 않았습니다.)';
        return;
      }
      if (!confirm(`이 브라우저에 저장된 지출 ${state.entries.length}건을 모두 지웁니다. 되돌릴 수 없습니다. 계속할까요?`)) return;
      // 지출 항목만 삭제합니다. 체크리스트 확인 결과는 별도 데이터입니다.
      const res = clearEntries();
      if (res.future || writeBlocked || !res.ok) {
        if (res.future) writeBlocked = true;
        if (warning) warning.hidden = true;
        if (status) status.textContent = res.future ? '더 새로운 형식 데이터라 저장소를 비우지 않았습니다.' : '저장소에 쓰지 못했습니다.';
        render();
        showLoadNote();
        return;
      }
      state.entries = [];
      removedIds = res.removed;
      droppedCount = 0;
      showLoadNote();
      render();
      if (status) status.textContent = '지출 목록을 비웠습니다. 체크리스트 확인 결과는 그대로 남아 있습니다.';
    });

    // 다른 탭에서 저장한 내용은 이 화면에 자동 반영합니다(합치기 규칙은 saveEntries 와 동일).
    window.addEventListener('storage', (event) => {
      if (event.key !== null && event.key !== STORAGE_KEY) return;
      const fresh = loadStateDetailed();
      if (fresh.future) {
        writeBlocked = true;
        showLoadNote();
        return;
      }
      const res = saveEntries(state.entries, removedIds);
      if (res.future) {
        writeBlocked = true;
        showLoadNote();
        render();
        return;
      }
      if (res.ok) {
        state.entries = res.merged;
        removedIds = res.removed;
      }
      droppedCount = fresh.dropped;
      showLoadNote();
      render();
    });

    render();
  }
</script>
