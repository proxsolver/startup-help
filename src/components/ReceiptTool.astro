---
import {
  CATEGORY_SUGGESTIONS,
  EVIDENCE_STATES,
  EVIDENCE_TYPES,
  PAY_METHODS,
  PERIOD_STATES,
  SUBMIT_STATES
} from '../lib/receipts';
import { MAX_REPORT_FIELD_CHARS, MAX_REPORT_NOTE_CHARS, REPORT_FIELDS } from '../lib/report';
import { MAX_IMPORT_BYTES } from '../lib/cardimport';
import { MAX_BACKUP_BYTES, MAX_BACKUP_ENTRIES, MAX_BACKUP_RECORDS } from '../lib/storage';

const today = new Date().toISOString().slice(0, 10);
/** 저장 로직의 칸 이름과 화면의 입력 id 를 한 곳에서 대응시킵니다(camelCase → rep-kebab-case). */
const fieldId = (key: string) => `rep-${key.replace(/([A-Z])/g, '-$1').toLowerCase()}`;
/** 안내 문구가 코드 상한과 다른 숫자를 보여주지 않도록, 파일 크기 한계도 상수에서 만들어 씁니다. */
const importLimit = `${Math.round(MAX_IMPORT_BYTES / 1024 / 1024)}MB까지`;
/** 화면 안내가 코드 상한과 다른 숫자를 보여주지 않도록, 이 문장은 상수에서 만들어 씁니다. */
const backupLimit = [
  `${Math.round(MAX_BACKUP_BYTES / 1024 / 1024)}MB`,
  `지출 ${MAX_BACKUP_ENTRIES.toLocaleString('ko-KR')}건`,
  `기록 ${MAX_BACKUP_RECORDS.toLocaleString('ko-KR')}개`
].join(' · ');
---

<div id="receipt-tool" class="tool-stack" data-tool>
  <p class="notice info no-print">
    <strong>서버에 올라가지 않는 도구입니다</strong>
    입력한 내용은 이 브라우저의 저장소에만 들어갑니다. 계정을 만들거나 영수증 파일을 전송하지 않아도 됩니다.
    다만 브라우저 데이터를 비우면 사라지므로, 마감 뒤에는 아래 내보내기 카드의 CSV·JSON 을 받아 두세요.
    여기서 고르는 항목은 정리용 분류일 뿐이며, 실제 인정 여부·서식 기준은 담당 주관기관 안내를 확인해야 합니다.
  </p>

  <div class="card no-print export">
    <h2>내보내기</h2>
    <p class="small muted">
      <strong>보고서 한 편</strong>은 이 화면의 행과 분류를 그대로 묶은 문서 파일입니다
      (보고서 머리 · 1 집행 목록 · 2 비목별 합계 · 3 증빙 공백) — 기관 공식 서식을 대체하지 않습니다.
    </p>
    <h3 id="exp-report">보고서 한 편</h3>
    <div class="row" role="group" aria-labelledby="exp-report">
      <div class="shrink"><button class="btn" type="button" data-export-report-html>보고서 HTML 내보내기</button></div>
      <div class="shrink"><button class="btn ghost" type="button" data-export-report-docx>보고서 DOCX 내보내기</button></div>
    </div>
    <h3 id="exp-backup">데이터 백업</h3>
    <div class="row" role="group" aria-labelledby="exp-backup">
      <div class="shrink"><button class="btn" type="button" data-export-csv>CSV 내보내기</button></div>
      <div class="shrink"><button class="btn" type="button" data-export-bundle>정산 꾸러미 내보내기</button></div>
      <div class="shrink"><button class="btn ghost" type="button" data-export-json>JSON 백업</button></div>
    </div>
  </div>

  <div class="card no-print">
    <h2>새 지출 추가</h2>
    <p class="notice" data-load-note hidden></p>
    <div class="fields" role="group" aria-label="지출 입력">
      <div>
        <label for="f-date">지출일</label>
        <input type="date" id="f-date" value={today} required />
      </div>
      <div>
        <label for="f-vendor">거래처</label>
        <input type="text" id="f-vendor" placeholder="예: 원단상사" autocomplete="off" />
      </div>
      <div>
        <label for="f-approval">승인번호</label>
        <input type="text" id="f-approval" placeholder="예: 01234567" autocomplete="off" inputmode="text" />
      </div>
      <div>
        <label for="f-amount">금액 (원)</label>
        <input type="number" id="f-amount" min="1" step="1" placeholder="예: 150000" inputmode="numeric" />
      </div>
      <div>
        <label for="f-budget">비목(예산과목)</label>
        <input type="text" id="f-budget" list="budget-list" placeholder="예: 시제품 제작" autocomplete="off" />
        <datalist id="budget-list">
          {CATEGORY_SUGGESTIONS.map((c) => <option value={c} />)}
        </datalist>
      </div>
      <div>
        <label for="f-pay">결제경로</label>
        <select id="f-pay">{PAY_METHODS.map((m) => <option value={m}>{m}</option>)}</select>
      </div>
      <div>
        <label for="f-period">집행 기간</label>
        <select id="f-period">{PERIOD_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div>
        <label for="f-evidence">증빙 종류</label>
        <select id="f-evidence">
          {EVIDENCE_TYPES.map((t) => <option value={t} selected={t === '없음'}>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="f-estate">수취 상태</label>
        <select id="f-estate">{EVIDENCE_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div>
        <label for="f-submit">제출 상태</label>
        <select id="f-submit">{SUBMIT_STATES.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
      <div class="wide">
        <label for="f-memo">메모</label>
        <input type="text" id="f-memo" placeholder="용도·요청받은 사람 한 줄" autocomplete="off" />
      </div>
      <div class="act">
        <button class="btn" type="button" data-add>추가</button>
      </div>
    </div>
    <p class="small muted" data-form-msg role="status" aria-live="polite"></p>
  </div>

  <div class="card no-print" data-imp-card>
    <h2>카드사 명세서 파일로 한 번에 넣기</h2>
    <p class="small muted">
      카드사에서 받은 표 계산 파일(<code>.xlsx</code> · <code>.csv</code> · <code>.tsv</code>)을 고르거나 이 칸에 끌어다 놓으면,
      거래일·가맹점명·금액·승인번호를 읽어 아래 미리보기로 보여줍니다. 추가 단추를 누르기 전에는 목록에 아무것도 들어가지 않습니다.
      <strong>파일이 서버로 올라가지는 않습니다</strong> — 이 사이트는 정적 페이지라 보낼 저장소가 없고, 읽는 코드가 전부 이 페이지 안에 있습니다.
    </p>
    <p class="small muted">
      양식이 알려 주지 않은 것(어느 카드가 전용카드인지 · 협약 집행기간 · 가맹점별 비목)만 아래 <strong>세 칸</strong>에서 한 번 정해 주세요.
      그 답은 이 브라우저에 저장되어 다음 달 파일부터 자동으로 적용됩니다. 정해 두지 않은 칸은 값을 추측하지 않고
      <strong>확인 필요</strong>·빈 비목으로 남기고, 미리보기 아래「이것만 정해 주세요」에 모아 보여줍니다.
    </p>
    <div class="row" role="group" aria-label="명세서 파일">
      <div class="wide">
        <label for="imp-file">명세서 파일 ({importLimit})</label>
        <input type="file" id="imp-file" accept=".xlsx,.xls,.csv,.tsv,text/csv" />
      </div>
    </div>
    <p class="notice" data-imp-drop hidden>여기에 파일을 놓으면 읽습니다.</p>
    <p class="notice" data-imp-error hidden></p>

    <details data-imp-settings class="sub-stack">
      <summary><strong>한 번만 정해 두는 설정</strong> <span class="muted small">(전용카드 끝번호 · 집행기간 · 가맹점→비목)</span></summary>
      <div class="fields" role="group" aria-label="수입 설정">
        <div class="wide">
          <label for="imp-tails">전용(체크)카드 끝번호 (쉼표로 여러 개)</label>
          <input type="text" id="imp-tails" placeholder="예: 441, 902" autocomplete="off" />
        </div>
        <div>
          <label for="imp-from">집행기간 시작</label>
          <input type="date" id="imp-from" />
        </div>
        <div>
          <label for="imp-to">집행기간 종료</label>
          <input type="date" id="imp-to" />
        </div>
      </div>
      <div>
        <label for="imp-rules">가맹점 이름 조각 → 비목 (한 줄에 하나)</label>
        <textarea id="imp-rules" rows="4" placeholder="예: 원단상사=재료비&#10;택배=운송비&#10;# 이 줄은 건너뜁니다"></textarea>
      </div>
      <div class="row row-top">
        <div class="shrink"><button class="btn" type="button" data-imp-settings-save>설정을 이 브라우저에 저장</button></div>
        <p class="small muted" data-imp-settings-note role="status" aria-live="polite"></p>
      </div>
      <p class="small muted">
        끝번호를 비워 두면 결제경로를 <strong>확인 필요</strong>로 둡니다 — 명세서의 선불·후불 표기만으로는 개인카드인지 전용카드인지 알 수 없습니다.
        집행기간을 비워 두면 기간 판정도 <strong>확인 필요</strong>로 남습니다.
      </p>
    </details>

    <div data-imp-preview hidden class="sub-stack">
      <p class="small" data-imp-summary></p>
      <p class="small muted scroll-hint" data-cols="8">열이 여덟 개입니다. 좁은 화면에서는 이 표를 좌우로 밀어 보세요.</p>
      <div class="table-scroll">
        <table>
          <caption class="small muted">미리보기 — 아래 「목록에 추가」를 눌러야 저장됩니다</caption>
          <thead>
            <tr>
              <th scope="col" class="keep">지출일</th><th scope="col">거래처</th><th scope="col" class="keep">승인번호</th><th scope="col" class="num">금액</th>
              <th scope="col">비목</th><th scope="col">결제경로</th><th scope="col">집행 기간</th><th scope="col">메모</th>
            </tr>
          </thead>
          <tbody data-imp-rows></tbody>
        </table>
      </div>
      <div class="notice info">
        <strong>이것만 정해 주세요</strong>
        <ul data-imp-gaps></ul>
      </div>
      <div class="row">
        <div class="shrink"><button class="btn" type="button" data-imp-commit>목록에 추가</button></div>
        <div class="shrink"><button class="btn ghost" type="button" data-imp-discard>미리보기 취소</button></div>
      </div>
      <p class="small muted">
        수취상태는 모두 <strong>미수취</strong>로 들어갑니다 — 카드사 명세서는 거래 내역을 알려주는 서류일 뿐 매출전표 원본이 아닙니다.
        전표 파일(PDF 등)을 받아「원본 확보」로 바꿔 두어야 정산 꾸러미에서 증빙 공백으로 잡히지 않습니다.
        같은 파일을 두 번 넣으면 이미 있는 행은 건너뛰고, 지난번에 지우신 행도 되살리지 않습니다(지운 기록이 그 id 를 기억합니다).
      </p>
    </div>
  </div>

  <div class="card no-print" data-report-card>
    <h2>보고서 머리에 넣을 값</h2>
    <p class="small muted">
      이 값은 보고서 머리(사업명 · 신청인·대표자 · 주관 기관 · 정산 기간 · 연락처 · 특이사항)에만 들어갑니다.
      숫자는 화면 요약과 같은 계산 함수에서 나옵니다 — 파일 때문에 값이 달라지지 않습니다.
      <strong>「저장」을 누르지 않아도</strong> 아래 입력창에 지금 적힌 값이 그대로 보고서에 들어갑니다 — 저장은 다음에 이 화면을 열 때를 위해 남기는 일입니다.
      기관에 보내기 전에 이 값들은 직접 확인해 주세요(사이트가 대신 정하지 않습니다). 파일을 받는 단추는 위 <strong>내보내기</strong> 카드에 있습니다.
    </p>

    <div class="fields" role="group" aria-label="보고서 정보">
      {
        REPORT_FIELDS.map((f) => {
          const id = fieldId(f.key);
          const wide = f.key === 'note' || f.key === 'projectName';
          return (
            <div class={wide ? 'wide' : undefined}>
              <label for={id}>
                {f.label}
                {f.required ? <span class="muted small"> (필수)</span> : <span class="muted small"> (선택)</span>}
              </label>
              {f.key === 'note' ? (
                <textarea id={id} rows="2" placeholder={f.hint} maxlength={MAX_REPORT_NOTE_CHARS} data-report-field={f.key} />
              ) : f.key === 'periodFrom' || f.key === 'periodTo' ? (
                <input type="date" id={id} data-report-field={f.key} />
              ) : (
                <input
                  type="text"
                  id={id}
                  placeholder={f.hint}
                  autocomplete="off"
                  maxlength={MAX_REPORT_FIELD_CHARS}
                  data-report-field={f.key}
                />
              )}
            </div>
          );
        })
      }
    </div>

    <div class="row row-top">
      <div class="shrink"><button class="btn ghost" type="button" data-report-save>보고서 정보를 이 브라우저에 저장</button></div>
      <p class="small muted" data-report-note role="status" aria-live="polite"></p>
    </div>

    <p class="notice" data-report-gaps hidden>
      <strong>보고서에 넣을 값이 더 필요합니다</strong>
      <ul data-report-gap-list></ul>
    </p>

    <p class="small muted">
      두 파일 모두 이 브라우저 안에서 조립되고, 담긴 값은 화면에 보이는 표와 같습니다. 내려받는 HTML 은 스크립트가 없는
      단일 파일입니다 — 열어 확인한 뒤 브라우저에서 <strong>인쇄 → PDF로 저장</strong> 하면 A4 보고서 PDF 가 됩니다.
      DOCX 는 OOXML(WordprocessingML) 규격을 지켜 이 사이트 코드가 손으로 조립한 파일이고, 글꼴은 맑은 고딕·Malgun Gothic 으로
      지정합니다(그 글꼴이 없는 컴퓨터에서는 대체 글꼴로 보일 수 있습니다). <strong>실제 워드·한글 프로그램에서 열어 고쳐 본 것은
      아직 아닙니다</strong> — 열리지 않거나 표가 어긋나면 HTML 로 받아 인쇄하거나, 위 <strong>데이터 백업</strong>의 CSV·꾸러미를 쓰세요.
      PDF 는 이 사이트가 직접 만들지 않습니다 — 한글 글꼴을 파일에 심지 않으면서
      올바르게 나오도록 만드는 방법을 확인하지 못했기 때문에, 인쇄 경로만 안내합니다.
    </p>
  </div>

  <div class="card">
    <h2>정리 현황</h2>
    <div class="fields no-print" role="group" aria-label="필터">
      <div>
        <label for="q-from">시작일</label>
        <input type="date" id="q-from" />
      </div>
      <div>
        <label for="q-to">종료일</label>
        <input type="date" id="q-to" />
      </div>
      <div>
        <label for="q-budget">비목</label>
        <select id="q-budget">
          <option value="">전체</option>
          {CATEGORY_SUGGESTIONS.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div>
        <label for="q-pay">결제경로</label>
        <select id="q-pay">
          <option value="">전체</option>
          {PAY_METHODS.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>
      <div>
        <label for="q-period">집행 기간</label>
        <select id="q-period">
          <option value="">전체</option>
          {PERIOD_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div>
        <label for="q-evidence">증빙 종류</label>
        <select id="q-evidence">
          <option value="">전체</option>
          {EVIDENCE_TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="q-estate">수취 상태</label>
        <select id="q-estate">
          <option value="">전체</option>
          {EVIDENCE_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div>
        <label for="q-submit">제출 상태</label>
        <select id="q-submit">
          <option value="">전체</option>
          {SUBMIT_STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div class="wide">
        <label for="q-text">거래처·승인번호·비목·메모 검색</label>
        <input type="search" id="q-text" placeholder="예: 택배" />
      </div>
      <div class="act">
        <button class="btn ghost" type="button" data-reset-filters>필터 해제</button>
      </div>
    </div>

    <dl class="stats" data-summary>
      <div><dt>총 집행액</dt><dd data-sum-total>-</dd></div>
      <div><dt>입력 건수</dt><dd data-sum-count>-</dd></div>
      <div><dt>전용카드로 결제</dt><dd data-sum-dedicated>-</dd></div>
      <div><dt>수취구멍(미수취·재요청)</dt><dd data-sum-gap>-</dd></div>
      <div><dt>기간 리스크(기간 외·확인 필요)</dt><dd data-sum-period>-</dd></div>
      <div><dt>제출 전</dt><dd data-sum-unsent>-</dd></div>
    </dl>

    <div class="agg">
      <div class="table-scroll">
        <table>
          <caption class="small muted">비목(예산과목)별 합계</caption>
          <thead><tr><th scope="col">비목</th><th scope="col" class="num">건수</th><th scope="col" class="num">금액</th></tr></thead>
          <tbody data-by-budget><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
        </table>
      </div>

      <div class="table-scroll">
        <table>
          <caption class="small muted">증빙 종류별 합계</caption>
          <thead><tr><th scope="col">증빙 종류</th><th scope="col" class="num">건수</th><th scope="col" class="num">금액</th></tr></thead>
          <tbody data-by-evidence><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
        </table>
      </div>

      <div class="table-scroll">
        <table>
          <caption class="small muted">월별 집행액</caption>
          <thead><tr><th scope="col">월</th><th scope="col" class="num">건수</th><th scope="col" class="num">금액</th></tr></thead>
          <tbody data-by-month><tr><td colspan="3" class="muted">자료가 없습니다</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card no-print" data-gap-card hidden>
    <h2>재요청이 필요한 건 <span class="muted small">(수취 못 한 순서대로)</span></h2>
    <p class="small muted scroll-hint no-print" data-cols="7">열이 일곱 개입니다. 좁은 화면에서는 이 표를 좌우로 밀어 보세요.</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col" class="keep">지출일</th><th scope="col">거래처</th><th scope="col" class="keep">승인번호</th><th scope="col" class="num">금액</th>
            <th scope="col">비목</th><th scope="col">수취 상태</th><th scope="col">메모</th>
          </tr>
        </thead>
        <tbody data-gap-rows></tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>입력 목록 <span class="muted small">(필터 적용된 결과)</span></h2>
    <p class="small muted scroll-hint no-print" data-cols="12">
      열이 열두 개(마지막은 지우기 버튼)입니다. 화면보다 표가 넓으면 좌우로 밀어 보세요.
      인쇄에는 지우기 열이 들어가지 않고, CSV 에는 이 표의 값에 전용카드 여부 열이 하나 더 들어갑니다.
      승인번호의 앞자리 0 은 CSV 에서 엑셀이 숫자로 바꿔 지울 수 있으니, 그대로 남아야 하는 자료는 JSON 백업을 쓰세요.
    </p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col" class="keep">지출일</th><th scope="col">거래처</th><th scope="col" class="keep">승인번호</th><th scope="col" class="num">금액</th>
            <th scope="col">비목</th><th scope="col">결제경로</th><th scope="col">집행 기간</th>
            <th scope="col">증빙 종류</th><th scope="col">수취</th><th scope="col">제출</th>
            <th scope="col">메모</th><th scope="col" class="no-print"><span aria-hidden="true">지우기</span></th>
          </tr>
        </thead>
        <tbody data-rows><tr><td colspan="12" class="muted">아직 입력이 없습니다.</td></tr></tbody>
        <tfoot data-foot hidden>
          <tr><th scope="row">합계</th><td></td><td></td><td class="num" data-foot-amount></td><td colspan="8"></td></tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="row no-print">
    <div>
      <label for="import-file">JSON 복원</label>
      <input type="file" id="import-file" accept="application/json,.json" />
    </div>
    <div class="shrink"><button class="btn danger" type="button" data-clear>지출 목록 비우기</button></div>
  </div>
  <div class="sub-stack no-print">
    <p class="small muted">
      <strong>정산 꾸러미</strong>는 지금 화면에 보이는 결과를 한 편으로 묶습니다 — 요약 · 증빙 공백 · 기간 리스크 · 제출 전 항목 · 비목/결제경로/월별 합계 · 체크리스트 남은 것, 그리고
      담당 기관에 보낼 <strong>증빙 요청 메일 초안</strong>(기관명·사업명은 〔 〕 으로 비워 둡니다 — 제가 알 수 없는 값이라). 텍스트 파일 하나로 내려받아 메모장·메일·인쇄 어디에서든 씁니다.
    </p>
    <p class="small muted">
      <strong>지출 목록 비우기</strong>는 이 브라우저에 저장된 지출 항목만 삭제합니다. 체크리스트 확인 결과는 그대로 남습니다.
    </p>
    <p class="small muted">
      <strong>JSON 복원</strong>은 이 도구가 내보낸 백업 파일만 읽습니다. 한 번에 받는 범위는 {backupLimit} 까지이고, 넘으면 복원하지 않고 사유를 알려줍니다 — 복원 시도 하나가 이 탭을 죽이지 못하게 하기 때문입니다.
    </p>
    <p class="small muted">
      <strong>JSON 백업</strong>에는 지출 목록 · 체크리스트 확인 결과 · 위 명세서 수입 설정(전용카드 끝번호 · 집행기간 · 가맹점→비목 규칙)이 함께 들어갑니다.
      다른 브라우저에서 복원하면 지난 달에 정해 둔 수입 규칙까지 그대로 적용됩니다.
    </p>
  </div>

  <p class="notice" data-storage-warning hidden>
    <strong>브라우저 저장에 실패했습니다</strong>
    시크릿 창이거나 저장 한도를 넘어선 것으로 보입니다. 지금 입력은 새로고침 뒤 사라집니다. JSON 백업을 먼저 받으세요.
  </p>
  <p class="small muted" data-status role="status" aria-live="polite"></p>
</div>

<script>
  import {
    computeTotals,
    csvFileName,
    evidenceGapList,
    exportPeriod,
    filterEntries,
    formatKRW,
    makeId,
    normalizeEntry,
    toCsvFile,
    type Filters,
    type ReceiptEntry
  } from '../lib/receipts';
  import { buildBundle, bundleFileName, dataPeriod } from '../lib/bundle';
  import {
    buildReport,
    normalizeReportMeta,
    reportBlankCount,
    reportFileName,
    reportGaps,
    reportToHtml,
    type Report,
    type ReportMeta
  } from '../lib/report';
  import { buildDocx, docxSupport } from '../lib/docx';
  import {
    cardSettingsToOptions,
    formatBudgetRuleLines,
    importCardFile,
    MAX_IMPORT_BYTES,
    normalizeCardSettings,
    parseBudgetRuleLines,
    parseTails,
    type CardSettings,
    type ImportResult
  } from '../lib/cardimport';
  import { CHECKLIST } from '../data/checklists';
  import {
    backupFileName,
    clearEntries,
    hasCardSettings,
    hasReportMeta,
    isBackupFileTooLarge,
    loadStateDetailed,
    MAX_BACKUP_BYTES,
    MAX_BACKUP_ENTRIES,
    MAX_TOMBSTONES,
    parseBackup,
    replaceEntries,
    saveCardSettings,
    saveEntries,
    saveMeta,
    saveReportMeta,
    serializeState,
    STORAGE_KEY,
    type RestoreRejection
  } from '../lib/storage';

  const root = document.querySelector<HTMLElement>('[data-tool]');

  if (root) {
    const el = (name: string): HTMLElement | null => root.querySelector<HTMLElement>(`[data-${name}]`);
    const input = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const val = (id: string) => input<HTMLInputElement | HTMLSelectElement>(id)?.value ?? '';
    const rowsBody = el('rows');
    const gapBody = el('gap-rows');
    const gapCard = el('gap-card');
    const foot = el('foot');
    const footAmount = el('foot-amount');
    const status = el('status');
    const formMsg = el('form-msg');
    const warning = el('storage-warning');
    const loadNote = el('load-note');

    const FILTER_IDS = ['q-from', 'q-to', 'q-budget', 'q-pay', 'q-period', 'q-evidence', 'q-estate', 'q-submit', 'q-text'];
    const SUGGESTED = new Set(
      Array.from(document.querySelectorAll('#budget-list option')).map((o) => (o as HTMLOptionElement).value)
    );

    const loaded = loadStateDetailed();
    let state = loaded.state;
    let filters: Filters = {};
    /** 지운 id 기록은 state.removed 하나만 씁니다(저장소·백업·화면이 같은 목록을 공유해야 지운 행이 되살아나지 않습니다). */
    let droppedCount = loaded.dropped;
    /** 삭제 기록이 상한에 밀려 몇 건 버려졌는지. 0 이 아니면 다른 탭이 그 행을 되살릴 수 있습니다. */
    let trimmedCount = 0;
    /** 다른 탭의 복원(전체 대체) 때문에 이 화면의 마지막 입력을 반영하지 못한 상태인지. */
    let restoredByOtherTab = false;
    let writeBlocked = loaded.future;

    function showLoadNote() {
      if (!loadNote) return;
      const notes: string[] = [];
      if (writeBlocked) {
        notes.push(
          '이 브라우저에 이 사이트의 더 새로운 형식 데이터가 있습니다. 형식을 되돌리면 데이터를 잃으므로 저장을 멈추고 읽기만 합니다. JSON 백업을 받은 뒤 그 버전을 쓰는 화면에서 열어 주세요.'
        );
      }
      if (droppedCount > 0) {
        notes.push(`저장된 항목 중 형식 때문에 읽지 못한 ${droppedCount}건이 있습니다. 그 행은 화면에 없는 것과 같고, 새로 저장하면 저장소에서 사라집니다.`);
      }
      if (trimmedCount > 0) {
        notes.push(
          `삭제 기록이 상한(${MAX_TOMBSTONES}건)을 넘어 최근 정리에서 ${trimmedCount}건을 더 기억하지 못했습니다. 이 화면을 오래 열어 둔 다른 탭이 그 행을 되살아나게 할 수 있으니, 다른 탭을 모두 닫고 새로 고침하세요.`
        );
      }
      if (restoredByOtherTab) {
        notes.push('다른 탭에서 지출 목록을 복원(전체 대체)해서, 이 화면이 방금 하려던 정리는 반영하지 않았습니다. 목록이 기대와 다르다면 이 탭에서 다시 정리해 주세요.');
      }
      loadNote.textContent = notes.join(' ');
      loadNote.hidden = notes.length === 0;
    }
    showLoadNote();

    function field(id: string): string {
      return val(id).trim();
    }

    function deliver(name: string, blob: Blob) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function download(name: string, text: string, type: string) {
      deliver(name, new Blob([text], { type }));
    }

    /** 바이트 산출물(DOCX)용. Blob 생성자가 타입스크립트에서 Uint8Array 를 바로 받지 않아 사본을 만들어 넘깁니다. */
    function downloadBytes(name: string, bytes: Uint8Array, type: string) {
      deliver(name, new Blob([bytes.slice().buffer as ArrayBuffer], { type }));
    }

    /** 셀 하나. 두 번째 인자는 화면 클래스만 받는 자리입니다(값 계산과 무관).
     *  `.num` = 금액(우측·tabular-nums) · `.keep` = 한 줄로 있어야 하는 문자열(지출일·승인번호). */
    function cell(text: string, cls = ''): HTMLElement {
      const td = document.createElement('td');
      td.textContent = text;
      if (cls) td.className = cls;
      return td;
    }

    function emptyRow(colSpan: number, text: string): HTMLElement {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = colSpan;
      td.className = 'muted';
      td.textContent = text;
      tr.appendChild(td);
      return tr;
    }

    /**
     * 비목 필터는 예시 목록에 없던 실제 입력값도 드롭다운에 쌓이도록 갱신합니다.
     * 반환값은 갱신 뒤 드롭다운에 실제로 선택된 값 — 지금 선택된 항목은 어떤 경우에도
     * 목록에서 지우지 않습니다(지우면 화면은 '전체' 를 보이는데 필터는 걸린 채로 집계되는 사고가 납니다).
     */
    function syncBudgetOptions(items: ReceiptEntry[], keep: string): string {
      const select = input<HTMLSelectElement>('q-budget');
      if (!select) return keep;
      const needed = new Set(items.map((e) => e.budgetItem).filter((b) => !SUGGESTED.has(b)));
      // removeOption() 은 WebKit 전용이라 표준 API 인 remove(index) 로 지웁니다(뒤에서부터).
      for (let i = select.options.length - 1; i >= 0; i--) {
        const opt = select.options[i];
        const v = opt.value;
        if (v && v !== keep && !SUGGESTED.has(v) && !needed.has(v)) select.remove(i);
      }
      const present = new Set(Array.from(select.options).map((o) => o.value));
      for (const key of [...needed].sort((a, b) => a.localeCompare(b, 'ko'))) {
        if (present.has(key)) continue;
        const opt = document.createElement('option');
        opt.value = key;
        opt.textContent = key;
        select.appendChild(opt);
      }
      select.value = keep;
      // keep 이 목록에 없던 값이라 브라우저가 선택을 유지 못 한 경우: 실제 표시된 값에 맞춰 필터를 고칩니다.
      return select.value;
    }

    function render() {
      const list = filterEntries(state.entries, filters);
      const totals = computeTotals(list);
      const gaps = evidenceGapList(list);

      const sum = (name: string, text: string) => {
        const node = el(name);
        if (node) node.textContent = text;
      };
      sum('sum-total', formatKRW(totals.total));
      sum('sum-count', `${totals.count}건`);
      sum('sum-dedicated', `${formatKRW(totals.dedicatedTotal)} (${totals.dedicatedRate}%)`);
      sum('sum-gap', `${totals.evidenceGapCount}건 · ${formatKRW(totals.evidenceGapTotal)}`);
      sum('sum-period', `${totals.periodRiskCount}건 · ${formatKRW(totals.periodRiskTotal)}`);
      sum('sum-unsent', `${totals.notSubmittedCount}건 · ${formatKRW(totals.notSubmittedTotal)}`);

      const fillGroup = (name: string, groups: { key: string; count: number; total: number }[]) => {
        const tbody = el(name);
        if (!tbody) return;
        tbody.textContent = '';
        if (groups.length === 0) {
          tbody.appendChild(emptyRow(3, '자료가 없습니다'));
          return;
        }
        for (const g of groups) {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = g.key;
          tr.appendChild(th);
          tr.appendChild(cell(`${g.count}건`, 'num'));
          tr.appendChild(cell(formatKRW(g.total), 'num strong'));
          tbody.appendChild(tr);
        }
      };
      fillGroup('by-budget', totals.byBudgetItem);
      fillGroup('by-evidence', totals.byEvidenceType);
      fillGroup('by-month', totals.byMonth);

      if (gapCard && gapBody) {
        gapCard.hidden = gaps.length === 0;
        gapBody.textContent = '';
        for (const e of gaps.slice(0, 30)) {
          const tr = document.createElement('tr');
          tr.appendChild(cell(e.date, 'keep'));
          tr.appendChild(cell(e.vendor || '-'));
          tr.appendChild(cell(e.approvalNo || '-', 'keep'));
          tr.appendChild(cell(formatKRW(e.amount), 'num strong'));
          tr.appendChild(cell(e.budgetItem));
          tr.appendChild(cell(e.evidenceState));
          tr.appendChild(cell(e.memo || '-'));
          gapBody.appendChild(tr);
        }
      }

      if (rowsBody) {
        rowsBody.textContent = '';
        if (list.length === 0) {
          rowsBody.appendChild(emptyRow(12, '조건에 맞는 입력이 없습니다.'));
        }
        for (const e of list) {
          const tr = document.createElement('tr');
          tr.appendChild(cell(e.date, 'keep'));
          tr.appendChild(cell(e.vendor || '-'));
          tr.appendChild(cell(e.approvalNo || '-', 'keep'));
          tr.appendChild(cell(formatKRW(e.amount), 'num'));
          tr.appendChild(cell(e.budgetItem));
          tr.appendChild(cell(e.payMethod));
          tr.appendChild(cell(e.periodState));
          tr.appendChild(cell(e.evidenceType));
          tr.appendChild(cell(e.evidenceState));
          tr.appendChild(cell(e.submitState));
          tr.appendChild(cell(e.memo || '-'));
          const td = document.createElement('td');
          // 헤더의 지우기 열은 인쇄에서 숨기는데 이 칸을 남기면, 열 개수가 맞지 않아
          // 인쇄 화면에 빈 열이 하나 더 생깁니다. 칸 자체도 인쇄에서 뺍니다.
          td.className = 'no-print';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn danger small no-print';
          btn.textContent = '지우기';
          btn.dataset.id = e.id;
          btn.addEventListener('click', () => remove(e.id));
          td.appendChild(btn);
          tr.appendChild(td);
          rowsBody.appendChild(tr);
        }
      }
      if (foot && footAmount) {
        foot.hidden = list.length === 0;
        footAmount.textContent = formatKRW(totals.total);
      }
      const shownBudget = syncBudgetOptions(state.entries, val('q-budget'));
      if (shownBudget !== (filters.budgetItem ?? '')) {
        filters = { ...filters, budgetItem: shownBudget || undefined };
      }
      if (status) {
        const saved = writeBlocked ? ' · 더 새로운 형식 데이터라 저장은 멈춰 있음' : '';
        status.textContent = `전체 ${state.entries.length}건 중 ${list.length}건 표시 · 데이터는 이 브라우저에만 저장됩니다${saved}`;
      }
    }

    /** 저장. 실패·차단은 화면에 알리고, 다른 탭이 추가한 행은 합쳐서 가져옵니다. */
    function persist() {
      if (writeBlocked) {
        if (warning) warning.hidden = false;
        showLoadNote();
        return;
      }
      const res = saveEntries(state.entries, state.removed, undefined, state.restoreAt);
      if (res.superseded) {
        // 다른 탭이 목록을 통째로 복원했습니다. 그쪽이 정답이므로 이 화면의 오래된 목록·삭제 기록을 섞지 않습니다.
        state.entries = res.merged;
        state.removed = res.removed;
        state.restoreAt = res.restoreAt;
        trimmedCount = 0;
        restoredByOtherTab = true;
        showLoadNote();
        render();
        return;
      }
      if (res.future) {
        writeBlocked = true;
        showLoadNote();
        if (warning) warning.hidden = false;
        render();
        return;
      }
      if (res.ok) {
        state.entries = res.merged;
        state.removed = res.removed;
        if (res.trimmed > 0) {
          trimmedCount = res.trimmed;
          showLoadNote();
        }
        if (restoredByOtherTab) {
          restoredByOtherTab = false;
          showLoadNote();
        }
      }
      if (warning) warning.hidden = res.ok;
    }

    function remove(id: string) {
      const before = state.entries.length;
      state.entries = state.entries.filter((e) => e.id !== id);
      if (state.entries.length !== before) {
        state.removed.push(id);
        persist();
        render();
      }
    }

    function add() {
      const rawAmount = field('f-amount');
      const amount = Number(rawAmount);
      if (rawAmount === '' || !Number.isFinite(amount) || amount <= 0) {
        if (formMsg) formMsg.textContent = '금액을 1 원 이상의 숫자로 입력하세요. 0 원·빈값은 저장하지 않습니다.';
        input<HTMLInputElement>('f-amount')?.focus();
        return;
      }
      const entry = normalizeEntry({
        id: makeId(),
        date: field('f-date'),
        vendor: field('f-vendor'),
        approvalNo: field('f-approval'),
        amount,
        budgetItem: field('f-budget'),
        payMethod: val('f-pay'),
        periodState: val('f-period'),
        evidenceType: val('f-evidence'),
        evidenceState: val('f-estate'),
        submitState: val('f-submit'),
        memo: field('f-memo')
      });
      if (!entry) {
        if (formMsg) formMsg.textContent = '지출일 형식(YYYY-MM-DD)을 확인해 주세요.';
        return;
      }
      state.entries.push(entry);
      state.entries.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
      persist();
      render();
      if (formMsg) {
        formMsg.textContent = `${entry.date} · ${entry.vendor || '이름 없음'} ${formatKRW(entry.amount)} · ${entry.budgetItem} 추가됨`;
      }
      const vendor = input<HTMLInputElement>('f-vendor');
      const approval = input<HTMLInputElement>('f-approval');
      const amountInput = input<HTMLInputElement>('f-amount');
      const memo = input<HTMLInputElement>('f-memo');
      if (vendor) vendor.value = '';
      if (approval) approval.value = '';
      if (amountInput) amountInput.value = '';
      if (memo) memo.value = '';
      vendor?.focus();
    }

    el('add')?.addEventListener('click', add);

    const syncFilters = () => {
      filters = {
        from: field('q-from') || undefined,
        to: field('q-to') || undefined,
        budgetItem: val('q-budget') || undefined,
        payMethod: val('q-pay') || undefined,
        periodState: val('q-period') || undefined,
        evidenceType: val('q-evidence') || undefined,
        evidenceState: val('q-estate') || undefined,
        submitState: val('q-submit') || undefined,
        q: field('q-text') || undefined
      };
      render();
    };
    for (const id of FILTER_IDS) {
      const node = document.getElementById(id);
      node?.addEventListener('change', syncFilters);
      if (node instanceof HTMLInputElement && node.type === 'search') node.addEventListener('input', syncFilters);
    }
    el('reset-filters')?.addEventListener('click', () => {
      resetFilterControls();
      render();
      if (status) status.textContent = '필터를 해제했습니다.';
    });

    el('export-csv')?.addEventListener('click', () => {
      // 화면에 보이는(필터 적용) 결과만 내보냅니다. 조건에 안 맞는 행을 몰래 포함시키지 않습니다.
      const visible = filterEntries(state.entries, filters);
      if (visible.length === 0) {
        if (status) {
          status.textContent =
            state.entries.length > 0
              ? '필터 조건에 맞는 건이 없어 내보낼 수 없습니다. 필터를 해제하거나 기간을 넓혀 주세요.'
              : '내보낼 데이터가 없습니다.';
        }
        return;
      }
      const name = csvFileName(exportPeriod(filters));
      download(name, toCsvFile(visible), 'text/csv;charset=utf-8');
      state.lastExportAt = new Date().toISOString();
      saveMeta({ lastExportAt: state.lastExportAt });
      if (status) status.textContent = `${name} · ${visible.length}건 내보냄 (화면에 표시된 결과만)`;
    });

    el('export-json')?.addEventListener('click', () => {
      download(backupFileName(), serializeState(state), 'application/json;charset=utf-8');
    });

    el('export-bundle')?.addEventListener('click', () => {
      // CSV 와 같은 기준: 필터까지 적용된 화면 결과만 묶습니다. 숨은 행을 몰래 넣지 않습니다.
      const visible = filterEntries(state.entries, filters);
      if (visible.length === 0) {
        if (status) {
          status.textContent =
            state.entries.length > 0
              ? '필터 조건에 맞는 건이 없어 꾸러미를 만들 수 없습니다. 필터를 해제하거나 기간을 넓혀 주세요.'
              : '지출 항목을 먼저 입력해 주세요.';
        }
        return;
      }
      // 기간 필터가 걸려 있으면 그 값대로, 없으면 이번 달을 적는 대신 실제로 들어 있는 집행 달을 기간으로 적습니다.
      // (기관에 보내는 파일의 '기간' 칸이 데이터와 다른 달이면 오해가 됩니다)
      const period = filters.from || filters.to ? exportPeriod(filters) : dataPeriod(visible);
      const text = buildBundle({
        entries: visible,
        checklist: state.checklist,
        items: CHECKLIST.flatMap((stage) => stage.items.map((i) => ({ id: i.id, label: i.label }))),
        period,
        generatedAt: new Date()
      });
      const name = bundleFileName(period);
      download(name, text, 'text/plain;charset=utf-8');
      state.lastExportAt = new Date().toISOString();
      saveMeta({ lastExportAt: state.lastExportAt });
      if (status) status.textContent = `${name} · ${visible.length}건으로 꾸러미 생성 (화면에 표시된 결과만, 브라우저 안에서 조립 — 전송 없음)`;
    });

    /* ───────── 보고서 내보내기 (HTML · 인쇄로 PDF) ───────── */
    /** 칸 목록은 화면이 아니라 REPORT_FIELDS 에서 만들어 렌더링한 DOM 에서 읽습니다(두 곳이 갈라지지 않게). */
    const REPORT_KEYS: string[] = Array.from(root.querySelectorAll<HTMLElement>('[data-report-field]'))
      .map((n) => n.dataset.reportField ?? '')
      .filter((k) => k !== '');
    const metaOf = (m: ReportMeta) => m as unknown as Record<string, string>;
    const repNode = (key: string) => root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-report-field="${key}"]`);
    const reportNote = el('report-note');
    const reportGapsBox = el('report-gaps');
    const reportGapList = el('report-gap-list');

    function metaFromInputs(): ReportMeta {
      const raw: Record<string, string> = {};
      for (const f of REPORT_KEYS) raw[f] = repNode(f)?.value ?? '';
      return normalizeReportMeta(raw);
    }

    function hydrateMetaInputs() {
      for (const f of REPORT_KEYS) {
        const node = repNode(f);
        if (node) node.value = metaOf(state.reportMeta)[f] ?? '';
      }
    }

    /** 채워 받지 않은 필수 칸만 모아 보여줍니다 — 보고서가 〔채우기〕 채로 나가기 직전에 보이는 창입니다. */
    function renderReportGaps(meta: ReportMeta = state.reportMeta) {
      if (!reportGapsBox || !reportGapList) return;
      const missing = reportGaps(meta);
      reportGapsBox.hidden = missing.length === 0;
      reportGapList.textContent = '';
      for (const g of missing) {
        const li = document.createElement('li');
        li.textContent = `${g.label} — ${g.hint}`;
        reportGapList.appendChild(li);
      }
    }

    el('report-save')?.addEventListener('click', () => {
      const res = saveReportMeta(metaFromInputs());
      state.reportMeta = res.meta;
      hydrateMetaInputs();
      renderReportGaps(res.meta);
      if (reportNote)
        reportNote.textContent = res.future
          ? '더 새로운 형식 데이터라 저장하지 않았습니다.'
          : res.ok
            ? '보고서 정보를 이 브라우저에 저장했습니다. 다음 보고서·JSON 백업에도 그대로 들어갑니다.'
            : '저장소에 쓰지 못했습니다. 이번 세션에서는 화면 값으로 보고서를 만들 수 있습니다.';
    });

    /**
     * 입력창을 고치는 동안에도 「이것만 채워 주세요」 목록이 따라옵니다. 저장을 누르기 전에도 화면이 문서와
     * 같은 것을 보게 두는 일입니다 — 목록이 저장된 값만 보면, 적어 놓고 안 누른 칸은 화면에서는 사라지고 문서에는 〔채우기〕 로 남습니다.
     */
    root.addEventListener('input', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('[data-report-card]')) renderReportGaps(metaFromInputs());
    });

    /**
     * 화면 상태(필터·**입력창에 지금 적힌 값**)로 보고서를 조립합니다. HTML · DOCX 가 같은 재료를 쓰도록 한 곳에 두었습니다 —
     * 두 파일이 서로 다른 행·숫자를 담는 사고를 구조로 막습니다.
     * 「저장」을 누르지 않은 입력도 그대로 들어갑니다(버튼은 다음 방문을 위해 남기는 일이고, 내보내기는 지금 화면의 값입니다).
     */
    function reportFromScreen(): { report: Report; period: string; count: number } | null {
      const visible = filterEntries(state.entries, filters);
      if (visible.length === 0) {
        if (status) {
          status.textContent =
            state.entries.length > 0
              ? '필터 조건에 맞는 건이 없어 보고서를 만들 수 없습니다. 필터를 해제하거나 기간을 넓혀 주세요.'
              : '지출 항목을 먼저 입력해 주세요.';
        }
        return null;
      }
      const meta = metaFromInputs();
      // 정산 기간은 보고서 머리에 적는 시작·종료가 1 순위입니다. 그 값이 없을 때만 화면 필터 기간,
      // 그것도 없으면 행에서 구한 최소~최대 달을 뒷값으로 씁니다 — 문서 머리와 파일 이름이 서로 다른
      // 기간을 말하지 않도록 순서를 한쪽에 고정해 둡니다(`buildReport` 의 precedence 가 이 순서입니다).
      const hasMetaPeriod = meta.periodFrom !== '' || meta.periodTo !== '';
      const fallbackPeriod = filters.from || filters.to ? exportPeriod(filters) : dataPeriod(visible);
      const report = buildReport({
        entries: visible,
        meta,
        period: hasMetaPeriod ? '' : fallbackPeriod,
        generatedAt: new Date()
      });
      // 파일 이름은 문서에 적힌 기간을 씁니다(이름과 문서가 다른 기간으로 갈라지지 않게).
      return { report, period: report.period, count: visible.length };
    }

    /** 산출물 공통 고지: 마지막 내보내기 시각을 남기고 건수·문서에 실제로 남은 빈칸 개수를 한 문장으로 알려줍니다. */
    function finishReportExport(name: string, made: { report: Report; count: number }, kind: string): string {
      state.lastExportAt = new Date().toISOString();
      saveMeta({ lastExportAt: state.lastExportAt });
      // 화면이 따로 세지 않고, 방금 만든 문서의 칸을 셉니다(고지한 개수와 파일 안의 〔채우기〕 가 항상 같습니다).
      const missing = reportBlankCount(made.report);
      return `${name} · ${made.count}건으로 ${kind} 보고서 생성 (화면에 표시된 결과만, 브라우저 안에서 조립 — 전송 없음)${
        missing > 0 ? ` · 입력창에 값이 없는 ${missing}칸은 문서에 〔채우기〕로 남았습니다` : ''
      }`;
    }

    el('export-report-html')?.addEventListener('click', () => {
      const made = reportFromScreen();
      if (!made) return;
      const name = `${reportFileName(made.period)}.html`;
      download(name, reportToHtml(made.report), 'text/html;charset=utf-8');
      if (status) status.textContent = finishReportExport(name, made, 'HTML');
    });

    el('export-report-docx')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const support = docxSupport();
      if (!support.ok) {
        if (status) status.textContent = support.why;
        return;
      }
      const made = reportFromScreen();
      if (!made) return;
      const label = button.textContent ?? '보고서 DOCX 내보내기';
      button.disabled = true; // 조립은 압축을 기다리는 일이라 두 번 누르면 파일이 두 개 나옵니다.
      button.textContent = 'DOCX 조립 중…';
      try {
        const bytes = await buildDocx(made.report);
        const name = `${reportFileName(made.period)}.docx`;
        downloadBytes(name, bytes, 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
        if (status) status.textContent = finishReportExport(name, made, 'DOCX');
      } catch (error) {
        if (status)
          status.textContent =
            error instanceof Error && error.message
              ? `DOCX 조립에 실패했습니다: ${error.message} (HTML 은 그대로 만들 수 있습니다)`
              : 'DOCX 를 만들지 못했습니다. 보고서 HTML 을 사용해 주세요.';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });

    /** 필터 DOM 과 상태(filters)를 한 번에 초기화 — 두개가 어긋나는 창을 없앱니다. */
    function resetFilterControls() {
      for (const id of FILTER_IDS) {
        const node = input<HTMLInputElement | HTMLSelectElement>(id);
        if (node) node.value = '';
      }
      filters = {};
    }

    /** 거부 사유를 사용자 문장으로 바꿉니다. 상한 숫자는 상수에서 만들어 표시가 어긋나지 않습니다. */
    function rejectMessage(rejected: Exclude<RestoreRejection, null>, at: number): string {
      const n = at.toLocaleString('ko-KR');
      if (rejected === 'too-large') return '파일이 읽을 수 있는 범위를 넘었습니다. 복원하지 않았습니다.';
      if (rejected === 'too-many')
        return `항목이 너무 많습니다(${n}건). 한 번에 복원하는 최대 건수는 ${MAX_BACKUP_ENTRIES.toLocaleString('ko-KR')}건입니다. 복원하지 않았습니다.`;
      return `담긴 기록이 너무 많습니다(${n}개). 이 도구가 만든 백업 파일인지 확인해 주세요. 복원하지 않았습니다.`;
    }

    const fileInput = input<HTMLInputElement>('import-file');
    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      // 파일을 메모리에 올리기 전에 크기부터 봅니다. 이 도구엔 서버가 없어 복원 전 과정이
      // 이 탭 안에서 일어나고, 저장을 거부하는 것만으로는 화면이 버팁니다.
      if (isBackupFileTooLarge(file.size)) {
        if (status)
          status.textContent = `파일이 너무 큽니다(${(file.size / 1024 / 1024).toFixed(1)}MB). 복원은 ${Math.round(
            MAX_BACKUP_BYTES / 1024 / 1024
          )}MB 까지만 받습니다. 읽지 않았습니다.`;
        fileInput.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const text = String(reader.result ?? '');
        const result = parseBackup(text);
        // 거부된 결과에는 state 가 들어 있지 않습니다(아래 흐름은 성공 경우만 지나갑니다).
        if (result.rejected) {
          if (status) status.textContent = rejectMessage(result.rejected, result.rejectedAt);
          fileInput.value = '';
          return;
        }
        const restored = result.state;
        const dropped = result.dropped;
        if (result.future) {
          if (status) status.textContent = '이 파일은 이 사이트의 더 새로운 형식 데이터입니다. 복원하지 않았습니다.';
          fileInput.value = '';
          return;
        }
        if (restored.entries.length === 0 && !confirm('이 파일에서 읽을 수 있는 지출 항목이 없습니다. 현재 데이터를 그대로 둘까요?')) {
          fileInput.value = '';
          return;
        }
        if (!confirm(`${restored.entries.length}건을 복원합니다. 현재 목록(${state.entries.length}건)은 대체됩니다.`)) {
          fileInput.value = '';
          return;
        }
        state.entries = restored.entries;
        state.removed = [];
        trimmedCount = 0;
        droppedCount = dropped;
        resetFilterControls();
        // 복원은 목록 전체를 대체합니다(다른 탭 행과 병합하지 않음). 체크리스트는 저장된 값 그대로 둡니다.
        // 수입 설정·보고서 머리는 예외로 파일 값을 받아들입니다 — 값 없는 오래된 백업이면 지금 값이 남고, 그 판단은 replaceEntries 가 돌려줍니다.
        const res = replaceEntries(state.entries, undefined, Date.now(), restored.cardSettings, restored.reportMeta);
        writeBlocked = res.future;
        state.restoreAt = res.restoreAt;
        state.cardSettings = res.cardSettings;
        state.reportMeta = res.reportMeta;
        hydrateSettingsInputs();
        hydrateMetaInputs();
        renderReportGaps();
        if (warning) warning.hidden = res.ok;
        showLoadNote();
        render();
        const skipped = dropped > 0 ? ` · 형식 오류 ${dropped}건은 건너뜀` : '';
        const settingsNote = hasCardSettings(restored.cardSettings) ? '· 파일의 수입 규칙을 적용' : '· 수입 규칙은 이 브라우저 값 유지';
        const metaNote = hasReportMeta(restored.reportMeta) ? '· 파일의 보고서 정보를 적용' : '· 보고서 정보는 이 브라우저 값 유지';
        if (status)
          status.textContent = res.ok
            ? `복원 완료 · ${state.entries.length}건${skipped} · ${settingsNote} · ${metaNote}`
            : `저장소에 쓰지 못했습니다 · 화면만 ${state.entries.length}건으로 바꿨습니다. 백업·다른 탭 저장 상태와 다를 수 있습니다.`;
        fileInput.value = '';
      };
      reader.onerror = () => {
        if (status) status.textContent = '파일을 읽을 수 없습니다.';
        fileInput.value = '';
      };
      reader.readAsText(file, 'utf-8');
    });

    el('clear')?.addEventListener('click', () => {
      if (state.entries.length === 0) {
        if (status) status.textContent = '지출 목록에 남은 항목이 없습니다. (체크리스트는 비우지 않았습니다.)';
        return;
      }
      if (!confirm(`이 브라우저에 저장된 지출 ${state.entries.length}건을 모두 지웁니다. 되돌릴 수 없습니다. 계속할까요?`)) return;
      // 지출 항목만 삭제합니다. 체크리스트 확인 결과는 별도 데이터입니다.
      const res = clearEntries();
      if (res.future || writeBlocked || !res.ok) {
        if (res.future) writeBlocked = true;
        // 쓰기에 실패했는데 경고 창을 숨기면 저장이 안 되는 상태를 모른 채 지나갑니다.
        if (warning) warning.hidden = false;
        if (status) status.textContent = res.future ? '더 새로운 형식 데이터라 저장소를 비우지 않았습니다.' : '저장소에 쓰지 못했습니다.';
        render();
        showLoadNote();
        return;
      }
      state.entries = [];
      state.removed = res.removed;
      if (res.trimmed > 0) trimmedCount = res.trimmed;
      droppedCount = 0;
      showLoadNote();
      render();
      if (status) status.textContent = '지출 목록을 비웠습니다. 체크리스트 확인 결과는 그대로 남아 있습니다.';
    });

    /* ───────── 카드사 명세서 파일 수입 ───────── */

    const impCard = el('imp-card');
    const impFile = input<HTMLInputElement>('imp-file');
    const impDrop = el('imp-drop');
    const impError = el('imp-error');
    const impPreview = el('imp-preview');
    const impSummary = el('imp-summary');
    const impRows = el('imp-rows');
    const impGaps = el('imp-gaps');
    const impCommit = el('imp-commit') as HTMLButtonElement | null;
    const impDiscard = el('imp-discard');
    const impSettings = document.querySelector<HTMLDetailsElement>('[data-imp-settings]');
    const impSettingsNote = el('imp-settings-note');
    /** 미리보기에는 열두 행만 — 큰 파일을 화면에 다 심으면 추가하기 전에 브라우저가 먼저 느려집니다. */
    const PREVIEW_ROWS = 12;

    let pending: ImportResult | null = null;
    let pendingName = '';
    /** 설정을 고쳐도 파일을 다시 고르지 않도록 마지막 File 을 이 화면 기억에 두고 다시 읽습니다. */
    let lastFile: File | null = null;

    function settingsFromInputs(): CardSettings {
      return normalizeCardSettings({
        dedicatedCardTails: parseTails(field('imp-tails')),
        periodFrom: field('imp-from'),
        periodTo: field('imp-to'),
        budgetRules: parseBudgetRuleLines(val('imp-rules'))
      });
    }

    function hydrateSettingsInputs(): void {
      const s = state.cardSettings;
      const tails = input<HTMLInputElement>('imp-tails');
      if (tails) tails.value = s.dedicatedCardTails.join(', ');
      const from = input<HTMLInputElement>('imp-from');
      if (from) from.value = s.periodFrom;
      const to = input<HTMLInputElement>('imp-to');
      if (to) to.value = s.periodTo;
      const rules = input<HTMLTextAreaElement>('imp-rules');
      if (rules) rules.value = formatBudgetRuleLines(s.budgetRules);
    }
    hydrateSettingsInputs();
    hydrateMetaInputs();
    renderReportGaps();

    function showImpError(lines: string[]): void {
      if (!impError) return;
      impError.textContent = '';
      for (const line of lines) {
        const span = document.createElement('span');
        span.className = 'line';
        span.textContent = line;
        impError.appendChild(span);
      }
      impError.hidden = false;
    }

    function clearImpError(): void {
      if (!impError) return;
      impError.textContent = '';
      impError.hidden = true;
    }

    /** 미리볼 행을 새 행 / 이미 있는 행 / 지운 적 있는 행으로 가릅니다(중복 id 는 있는 행으로 칩니다). */
    function splitPending(): { fresh: ReceiptEntry[]; existing: number; resurrect: number } {
      const fresh: ReceiptEntry[] = [];
      let existing = 0;
      let resurrect = 0;
      if (!pending) return { fresh, existing, resurrect };
      const known = new Set(state.entries.map((e) => e.id));
      const gone = new Set(state.removed);
      const seen = new Set<string>();
      for (const e of pending.entries) {
        if (known.has(e.id) || seen.has(e.id)) {
          existing++;
          continue;
        }
        seen.add(e.id);
        if (gone.has(e.id)) {
          resurrect++;
          continue;
        }
        fresh.push(e);
      }
      return { fresh, existing, resurrect };
    }

    function renderPreview(): void {
      if (!impPreview || !impRows || !impGaps || !impSummary || !impCommit) return;
      if (!pending) {
        impPreview.hidden = true;
        return;
      }
      impPreview.hidden = false;
      const { fresh, existing, resurrect } = splitPending();

      impRows.textContent = '';
      for (const e of fresh.slice(0, PREVIEW_ROWS)) {
        const tr = document.createElement('tr');
        for (const [text, cls] of [
          [e.date, 'keep'],
          [e.vendor || '(거래처 없음)', ''],
          [e.approvalNo || '—', 'keep'],
          [formatKRW(e.amount), 'num'],
          [e.budgetItem || '(비목 미정)', ''],
          [e.payMethod, ''],
          [e.periodState, ''],
          [e.memo, '']
        ] as [string, string][])
          tr.appendChild(cell(text, cls));
        impRows.appendChild(tr);
      }
      if (fresh.length > PREVIEW_ROWS) {
        const tr = document.createElement('tr');
        const td = document.createElement('td');
        td.colSpan = 8;
        td.className = 'muted';
        td.textContent = `외 ${fresh.length - PREVIEW_ROWS}건 — 추가를 누르면 미리보지 않은 행까지 한 번에 들어갑니다`;
        tr.appendChild(td);
        impRows.appendChild(tr);
      }

      const bits = [`파일 행 ${pending.totalRows}개`, `집행 행 ${pending.entries.length}건`, `추가할 행 ${fresh.length}건`];
      if (existing > 0) bits.push(`이미 목록에 있는 ${existing}건은 건너뜀`);
      if (resurrect > 0) bits.push(`지난번에 지운 ${resurrect}건은 되살리지 않음`);
      impSummary.textContent = `${pendingName} · ${bits.join(' · ')}`;
      impCommit.textContent = fresh.length > 0 ? `${fresh.length}건을 목록에 추가` : '추가할 새 행이 없습니다';
      impCommit.disabled = fresh.length === 0;

      impGaps.textContent = '';
      for (const g of pending.gaps) {
        const li = document.createElement('li');
        const items = g.items.length > 0 ? ` — ${g.items.slice(0, 6).join(', ')}${g.items.length > 6 ? ` 외 ${g.items.length - 6}개` : ''}` : '';
        li.textContent = `${g.label}${items}`;
        impGaps.appendChild(li);
      }
      if (pending.gaps.length === 0) {
        const li = document.createElement('li');
        li.textContent = '정해 주지 않으면 안 되는 것이 남지 않았습니다.';
        impGaps.appendChild(li);
      }
    }

    async function readCardFile(file: File): Promise<void> {
      clearImpError();
      if (file.size > MAX_IMPORT_BYTES) {
        pending = null;
        renderPreview();
        showImpError([
          `파일이 ${(MAX_IMPORT_BYTES / 1024 / 1024).toFixed(0)}MB 를 넘어 읽지 않았습니다. 명세서 파일치고는 너무 큽니다.`,
          '엑셀에서 필요한 기간 행만 잘라 다른 파일로 저장해 넣거나, CSV 로 저장해 주세요.'
        ]);
        return;
      }
      lastFile = file;
      try {
        const result = await importCardFile(file, cardSettingsToOptions(state.cardSettings));
        pending = result;
        pendingName = file.name;
        renderPreview();
        if (result.entries.length === 0) {
          showImpError([
            '이 파일에서는 집행 행을 한 건도 읽지 못했습니다. 위에서 알려준 사유를 확인해 주세요.',
            '읽은 행이 하나도 없는 상태이므로 집행 목록에는 아무것도 들어가지 않았습니다.'
          ]);
        } else if (impSettings && result.gaps.some((g) => g.kind !== 'evidence-unread')) {
          // 답할 칸이 닫힌 채 목록만 보여 주지 않도록, 정할 것이 남아 있으면 설정 상자를 엽니다.
          impSettings.open = true;
        }
        if (status) status.textContent = `${file.name} · ${result.entries.length}건 미리보기 (아직 추가 전)`;
      } catch (e) {
        pending = null;
        renderPreview();
        const reason = e instanceof Error ? e.message : String(e);
        const xlsxHint =
          /\.xlsx?$/i.test(file.name)
            ? ' .xlsx 는 브라우저가 zip 압축을 풀어 읽습니다(Chrome 103 · Safari 16.4 · Firefox 113 이후). 이 브라우저에서 그 기능이 안 돌아가면 엑셀에서 CSV 또는 TSV로 저장해 넣어 주세요 — CSV 는 압축 없이 읽힙니다.'
            : '';
        showImpError([`파일을 읽지 못했습니다: ${reason}${xlsxHint}`, '읽기에 실패한 파일은 집행 목록에 한 행도 넣지 않았습니다.']);
        if (status) status.textContent = `${file.name} 읽기에 실패했습니다.`;
      } finally {
        // 입력란을 비워 둡니다 — 같은 파일을 다시 골라도 change 가 걸립니다.
        if (impFile) impFile.value = '';
      }
    }

    impFile?.addEventListener('change', () => {
      const f = impFile.files?.[0];
      if (f) void readCardFile(f);
    });

    let dragDepth = 0;
    impCard?.addEventListener('dragenter', (event) => {
      event.preventDefault();
      dragDepth++;
      if (impDrop) impDrop.hidden = false;
    });
    impCard?.addEventListener('dragover', (event) => {
      // 놓는 것을 허용하지 않으면 drop 이 아예 발생하지 않습니다.
      event.preventDefault();
    });
    impCard?.addEventListener('dragleave', () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0 && impDrop) impDrop.hidden = true;
    });
    impCard?.addEventListener('drop', (event) => {
      event.preventDefault();
      dragDepth = 0;
      if (impDrop) impDrop.hidden = true;
      const f = (event as DragEvent).dataTransfer?.files?.[0];
      if (f) void readCardFile(f);
      else showImpError(['드래그한 것에서 파일을 찾지 못했습니다. 파일 자체를 이 칸에 놓아 주세요(선택한 텍스트·링크는 읽지 않습니다).']);
    });

    impCommit?.addEventListener('click', () => {
      if (!pending) return;
      const { fresh, existing, resurrect } = splitPending();
      if (fresh.length === 0) {
        if (status) status.textContent = '추가할 새 행이 없습니다. 이미 목록에 있는 행입니다.';
        return;
      }
      state.entries = state.entries.concat(fresh).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
      persist();
      render();
      const notes: string[] = [];
      if (existing > 0) notes.push(`이미 있던 ${existing}건 건너뜀`);
      if (resurrect > 0) notes.push(`지운 적 있는 ${resurrect}건은 되살리지 않음(필요하면 새 지출 추가에 입력하세요)`);
      if (status) status.textContent = `${pendingName} · ${fresh.length}건 추가${notes.length ? ` · ${notes.join(' · ')}` : ''}`;
      pending = null;
      pendingName = '';
      lastFile = null;
      renderPreview();
    });

    impDiscard?.addEventListener('click', () => {
      pending = null;
      pendingName = '';
      lastFile = null;
      clearImpError();
      renderPreview();
      if (status) status.textContent = '미리보기를 취소했습니다. 목록은 그대로입니다.';
    });

    el('imp-settings-save')?.addEventListener('click', () => {
      const res = saveCardSettings(settingsFromInputs());
      state.cardSettings = res.settings;
      hydrateSettingsInputs();
      if (impSettingsNote) {
        impSettingsNote.textContent = res.future
          ? '이 브라우저에 더 새로운 형식 데이터가 있어 설정을 저장하지 않았습니다. 이번 화면에서는 적용됩니다.'
          : res.ok
            ? '저장했습니다 — 다음 파일부터 이 설정으로 읽습니다. JSON 백업에도 함께 들어갑니다.'
            : '이 브라우저 저장에 실패했습니다. 이번 화면에서는 적용되지만 새로 고침하면 사라집니다.';
      }
      // 설정을 고치면 미리보기도 바뀐 설정으로 다시 읽힙니다(파일을 다시 골라야 하는 번거로움을 없애기 위해).
      if (lastFile) void readCardFile(lastFile);
    });

    // 다른 탭에서 저장한 내용은 이 화면에 자동 반영합니다(합치기 규칙은 saveEntries 와 동일).
    window.addEventListener('storage', (event) => {
      if (event.key !== null && event.key !== STORAGE_KEY) return;
      const fresh = loadStateDetailed();
      if (fresh.future) {
        writeBlocked = true;
        showLoadNote();
        return;
      }
      // 다른 탭이 백업 복원으로 목록을 통째로 대체했다면 그쪽이 정답입니다.
      // 이 화면이 복원 전에 열려 있었다면 들고 있던 삭제 기록이 방금 복원된 행을 지워버리므로 섞지 않습니다.
      if ((fresh.state.restoreAt ?? 0) > (state.restoreAt ?? 0)) {
        state = fresh.state;
        trimmedCount = 0;
        droppedCount = fresh.dropped;
        // 목록이 통째로 바뀐만큼 수입 설정·보고서 머리 입력도 그쪽 값으로 맞춥니다(화면과 상태가 어긋난 채로 입력되지 않게).
        hydrateSettingsInputs();
        hydrateMetaInputs();
        renderReportGaps();
        showLoadNote();
        render();
        if (status) status.textContent = '다른 탭에서 목록을 복원했습니다. 이 화면도 그 내용으로 바꿨습니다.';
        return;
      }
      const res = saveEntries(state.entries, state.removed, undefined, state.restoreAt);
      if (res.future) {
        writeBlocked = true;
        showLoadNote();
        render();
        return;
      }
      if (res.superseded) {
        state.entries = res.merged;
        state.removed = res.removed;
        state.restoreAt = res.restoreAt;
        trimmedCount = 0;
        droppedCount = fresh.dropped;
        showLoadNote();
        render();
        return;
      }
      if (res.ok) {
        state.entries = res.merged;
        state.removed = res.removed;
        state.restoreAt = fresh.state.restoreAt;
        if (res.trimmed > 0) trimmedCount = res.trimmed;
      }
      droppedCount = fresh.dropped;
      showLoadNote();
      render();
    });

    render();
  }
</script>
