---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import VerificationNotice from '../../../components/VerificationNotice.astro';
import SourceList from '../../../components/SourceList.astro';
import { AUDIENCE_LABEL, categoryTitle } from '../../../data/categories';
import { p } from '../../../lib/url';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => {
    const [category, ...rest] = g.id.split('/');
    return {
      params: { category, slug: rest.join('/') },
      props: { guide: g }
    };
  });
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const d = guide.data;
const path = `/guide/${d.category}/${guide.id.split('/').slice(1).join('/')}/`;
const related = (await getCollection('guides', (e) => e.data.category === d.category && e.id !== guide.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const fmt = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' }).format(d.updatedAt);
---

<Base title={d.title} description={d.summary} path={path}>
  <article class="measure">
    <p class="small"><a href={p('/guide/')}>안내</a> › <a href={p(`/guide/${d.category}/`)}>{categoryTitle(d.category)}</a></p>
    <h1>{d.title}</h1>
    <p class="muted small" style="margin-top:-0.4rem">
      갱신 {fmt} · 대상 {d.audience.map((a) => AUDIENCE_LABEL[a] ?? a).join(', ')} · {categoryTitle(d.category)}
    </p>

    <VerificationNotice status={d.verification} note={d.verificationNote} updatedAt={d.updatedAt} />

    <div class="prose">
      <Content />
    </div>

    <SourceList sources={d.sources} />

    {
      related.length > 0 && (
        <section class="no-print">
          <h2>같은 분류의 다른 안내</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={p(`/guide/${r.id}/`)}>{r.data.title}</a>
                <span class="muted small"> — {r.data.summary}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="notice no-print">
      <strong>이 사이트는 공식 안내가 아니며 세무·법률 자문을 제공하지 않습니다</strong>
      인정 범위·제출 시점은 담당 주관기관 공고와 협약서 기준이고, 세무 처리 여부는 관할 세무서 또는 세무사 확인이
      필요합니다. 위 "확인할 곳" 링크에서 최신 기준을 직접 확인하세요.
    </p>
  </article>
</Base>
