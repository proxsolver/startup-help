---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { p } from '../lib/url';

const guides = await getCollection('guides');
---

<Base title="페이지를 찾을 수 없습니다" description="주소가 바뀌거나 문서가 아직 없습니다." path="/404/">
  <h1>페이지가 없습니다</h1>
  <p class="muted">
    주소가 바뀌었거나, 아직 없는 문서로 연결됐을 수 있습니다. 검색으로 찾아 보시겠어요?
  </p>
  <ul>
    {
      guides.slice(0, 12).map((g) => (
        <li>
          <a href={p(`/guide/${g.id}/`)}>{g.data.title}</a>
        </li>
      ))
    }
  </ul>
  <p>
    <a href={p('/')}>홈</a> · <a href={p('/guide/')}>안내 전체</a> · <a href={p('/tools/receipts/')}>영수증 정리</a>
  </p>
</Base>
